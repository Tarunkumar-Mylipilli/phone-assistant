<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A">

    <!-- Main Scrollable Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Header with Glowing Orb & Voice Speaker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="18dp"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/ivOrb"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/orb_gradient"
                    android:contentDescription="Evolve AI Core Orb" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EVOLVE AI • JARVIS OS"
                        android:textColor="#00E5FF"
                        android:letterSpacing="0.15"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Life Operating System"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Voice Mute/Read Out Loud Toggle -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVoiceSpeak"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Speak 🔊"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    app:strokeColor="#00E5FF"
                    app:cornerRadius="19dp" />
            </LinearLayout>

            <!-- SECTION 1: HOME DASHBOARD CONTAINER -->
            <LinearLayout
                android:id="@+id/sectionHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Morning Briefing Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#1F2A44"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#121829">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DAILY OPERATING BRIEF"
                            android:textColor="#00E5FF"
                            android:textSize="11sp"
                            android:letterSpacing="0.1"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDailyBrief"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:text="Good day. Your OS is primed for high-leverage execution. 4 milestones scheduled across career and health."
                            android:textColor="#E0E6ED"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvFinanceOverview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="💰 Savings Target: Loading..."
                            android:textColor="#00E5FF"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Device Health & RAM Cleaner -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#1F2A44"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#121829">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="REALME GT 2 (SD 888) • MEMORY"
                            android:textColor="#7C4DFF"
                            android:textSize="11sp"
                            android:letterSpacing="0.1"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvMemoryInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Available RAM: Loading..."
                            android:textColor="#E0E6ED"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvBatteryInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Battery: Loading..."
                            android:textColor="#A0AEC0"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCleanRam"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#7C4DFF"
                            android:text="Clean Background Cache &amp; Apps"
                            android:textColor="#FFFFFF"
                            app:cornerRadius="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnScreenTimeSettings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:backgroundTint="#1F2A44"
                            android:text="Digital Wellbeing &amp; Limits"
                            android:textColor="#00E5FF"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- SECTION 2: AI ASSISTANT CHAT CONTAINER -->
            <LinearLayout
                android:id="@+id/sectionAssistant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#1F2A44"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#121829">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvAiResponse"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="5"
                            android:lineSpacingExtra="4dp"
                            android:text="Jarvis is ready.\n\nAsk anything regarding your schedule, DSA &amp; system design roadmaps, workout plans, or type 'remember &lt;note&gt;'."
                            android:textColor="#E0E6ED"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Query Input Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/etUserQuery"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="#121829"
                        android:hint="Ask Jarvis or schedule tasks..."
                        android:textColorHint="#4A5568"
                        android:textColor="#FFFFFF"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendQuery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#00E5FF"
                        android:text="Send"
                        android:textColor="#0A0E1A"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <!-- Quick AI Command Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/chipBriefing"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Daily Brief"
                        android:textColor="#00E5FF"
                        app:strokeColor="#00E5FF" />

                    <Button
                        android:id="@+id/chipCareer"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Career Plan"
                        android:textColor="#7C4DFF"
                        app:strokeColor="#7C4DFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- SECTION 3: CAREER & LEARNING ROADMAP CONTAINER -->
            <LinearLayout
                android:id="@+id/sectionCareer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAREER GROWTH &amp; TECH ROADMAP"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvSkillsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:text="Loading skills..."
                    android:textColor="#E0E6ED"
                    android:textSize="14sp"
                    android:background="#121829"
                    android:padding="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMockInterview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#7C4DFF"
                    android:text="Start AI Mock Technical Interview"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <!-- SECTION 4: HABITS, HEALTH & FINANCE CONTAINER -->
            <LinearLayout
                android:id="@+id/sectionHabits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DAILY HABITS &amp; STREAK TRACKER"
                    android:textColor="#7C4DFF"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvHabitsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:text="Loading habits..."
                    android:textColor="#E0E6ED"
                    android:textSize="14sp"
                    android:background="#121829"
                    android:padding="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckInHabit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#00E5FF"
                    android:text="Check In Today's Coding &amp; Workout"
                    android:textColor="#0A0E1A"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <!-- SECTION 5: AI BRAIN & GGUF MODEL MANAGER -->
            <LinearLayout
                android:id="@+id/sectionModels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFFLINE GGUF AI BRAIN &amp; HARDWARE (REALME GT 2)"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#1F2A44"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#121829">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvModelCatalog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="5dp"
                            android:text="Loading offline AI models..."
                            android:textColor="#E0E6ED"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSwitchEngine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#00E5FF"
                            android:text="Cycle Active AI Engine"
                            android:textColor="#0A0E1A"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#0D1222"
        app:itemTextColor="#00E5FF"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
