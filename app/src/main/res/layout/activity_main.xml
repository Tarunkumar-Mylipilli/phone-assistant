<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A">

    <!-- Main Scrollable Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="72dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Header with Glowing Orb & Voice Speaker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="18dp"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/ivOrb"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/orb_gradient"
                    android:contentDescription="Evolve AI Core Orb" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EVOLVE AI • SYSTEM ASSISTANT"
                        android:textColor="#00E5FF"
                        android:letterSpacing="0.15"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Life Operating System"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Voice Listen / Speech to Text Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVoiceSpeak"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Speak 🎙️"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    app:strokeColor="#00E5FF"
                    app:cornerRadius="19dp" />
            </LinearLayout>

            <!-- SECTION 1: HOME DASHBOARD CONTAINER -->
            <LinearLayout
                android:id="@+id/sectionHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- System Assistant Privileges & Overlay Control Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#00E5FF"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#121829">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SYSTEM-LEVEL ASSISTANT CONTROLS"
                            android:textColor="#00E5FF"
                            android:letterSpacing="0.1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Enable floating microphone overlay or configure Evolve AI as your default Android assistant (replacing Google Assistant)."
                            android:textColor="#CFD8DC"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleBubble"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="ACTIVATE FLOATING OVERLAY BUBBLE"
                            android:textColor="#0A0E1A"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"
                            app:backgroundTint="#00E5FF"
                            app:cornerRadius="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetDefaultAssistant"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="SET AS DEFAULT ANDROID ASSISTANT"
                            android:textColor="#00E5FF"
                            app:strokeColor="#00E5FF"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Daily Briefing Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#1F2A44"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#121829">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SYSTEM STATUS &amp; BRIEF"
                            android:textColor="#00E5FF"
                            android:letterSpacing="0.1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvDailyBrief"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Evolve AI initialized. All modules ready with zero fabricated data."
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Hardware Performance & Diagnostics -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#1F2A44"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#121829">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DEVICE DIAGNOSTICS &amp; RAM"
                            android:textColor="#9E9E9E"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvMemoryInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="RAM: Checking..."
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvBatteryInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Battery: Checking..."
                            android:textColor="#9E9E9E"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCleanRam"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:text="OPTIMIZE SYSTEM RAM"
                            android:textColor="#0A0E1A"
                            android:textStyle="bold"
                            app:backgroundTint="#00E5FF"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnScreenTimeSettings"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="OPEN DIGITAL WELLBEING"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="8dp"
                            app:strokeColor="#1F2A44"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- SECTION 2: AI ASSISTANT & CHAT CONTAINER -->
            <LinearLayout
                android:id="@+id/sectionAssistant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Quick Action Chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipAlarm"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="⏰ Alarm 4:30 AM"
                            android:textColor="#00E5FF"
                            android:textSize="11sp"
                            android:layout_marginEnd="8dp"
                            app:strokeColor="#00E5FF"
                            app:cornerRadius="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipTimer"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="⏳ Timer 10m"
                            android:textColor="#00E5FF"
                            android:textSize="11sp"
                            android:layout_marginEnd="8dp"
                            app:strokeColor="#00E5FF"
                            app:cornerRadius="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipSqlLearn"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="🎓 Learn SQL 8 PM"
                            android:textColor="#00E5FF"
                            android:textSize="11sp"
                            app:strokeColor="#00E5FF"
                            app:cornerRadius="18dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- AI Response Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#1F2A44"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#121829">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="JARVIS COGNITIVE OUTPUT"
                            android:textColor="#00E5FF"
                            android:letterSpacing="0.1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvAiResponse"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Awaiting command. Speak via the top mic or type below."
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Query Input Form -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#1F2A44"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#121829">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <EditText
                            android:id="@+id/etUserQuery"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Type or speak (e.g. 'Open YouTube', 'Set alarm 4:30 AM')"
                            android:textColorHint="#546E7A"
                            android:textColor="#FFFFFF"
                            android:background="@null"
                            android:minHeight="48dp"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSendQuery"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="EXECUTE COMMAND"
                            android:textColor="#0A0E1A"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            app:backgroundTint="#00E5FF"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- SECTION 3: SMART LEARNING DASHBOARD -->
            <LinearLayout
                android:id="@+id/sectionLearning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#1F2A44"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#121829">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvLearningHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SMART LEARNING PREPARATION"
                            android:textColor="#00E5FF"
                            android:letterSpacing="0.1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvLessonStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status: READY (Pre-Session Notes Prepared)"
                            android:textColor="#00E676"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvLessonContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Select or schedule a learning roadmap above."
                            android:textColor="#CFD8DC"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp"
                            android:layout_marginBottom="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCompleteLesson"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="COMPLETE LESSON &amp; TAKE QUIZ"
                            android:textColor="#0A0E1A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            app:backgroundTint="#00E5FF"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- SECTION 4: VISION COACH WITH CAMERAX PREVIEW -->
            <LinearLayout
                android:id="@+id/sectionVision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#1F2A44"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#121829">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI VISION COACH &amp; CAMERAX LIVE FEED"
                            android:textColor="#00E5FF"
                            android:letterSpacing="0.1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <!-- CameraX PreviewView for Live Sensor Stream -->
                        <androidx.camera.view.PreviewView
                            android:id="@+id/previewView"
                            android:layout_width="match_parent"
                            android:layout_height="240dp"
                            android:background="#000000" />

                        <!-- Captured Frame View (hidden by default) -->
                        <ImageView
                            android:id="@+id/ivCameraFrame"
                            android:layout_width="match_parent"
                            android:layout_height="240dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:background="#0A0E1A"
                            android:contentDescription="Captured Frame" />

                        <TextView
                            android:id="@+id/tvLiveGuidance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="✨ Real-Time Guidance: Analyzing scene parameters..."
                            android:textColor="#00E5FF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPhotoScore"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Quality Score: Live Sensor Stream Active"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvPhotoFeedback"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Laplacian Edge Variance &amp; Rule of Thirds Active"
                            android:textColor="#9E9E9E"
                            android:textSize="11sp"
                            android:layout_marginBottom="14dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCycleCoachMode"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:text="Mode: Portrait"
                                android:textColor="#00E5FF"
                                android:textSize="11sp"
                                android:layout_marginEnd="6dp"
                                app:strokeColor="#00E5FF"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCapturePhoto"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:text="📸 ANALYZE FRAME"
                                android:textColor="#0A0E1A"
                                android:textStyle="bold"
                                android:textSize="11sp"
                                android:layout_marginStart="6dp"
                                app:backgroundTint="#00E5FF"
                                app:cornerRadius="10dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- SECTION 5: NATIVE PHONE ACTION TRIGGERS -->
            <LinearLayout
                android:id="@+id/sectionActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#1F2A44"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#121829">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NATIVE ANDROID PHONE TRIGGERS"
                            android:textColor="#00E5FF"
                            android:letterSpacing="0.1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTriggerAlarm"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="SET ALARM TOMORROW AT 4:30 AM"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="8dp"
                            app:backgroundTint="#1F2A44"
                            app:cornerRadius="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTriggerTimer"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="SET TIMER FOR 10 MINUTES"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="8dp"
                            app:backgroundTint="#1F2A44"
                            app:cornerRadius="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLaunchYouTube"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="LAUNCH YOUTUBE"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="8dp"
                            app:backgroundTint="#1F2A44"
                            app:cornerRadius="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLaunchMaps"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="NAVIGATE TO NEARBY GYM"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#1F2A44"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="#0D111E"
        app:itemIconTint="#00E5FF"
        app:itemTextColor="#FFFFFF"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
